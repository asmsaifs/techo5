diff --git a/sound/soc/mediatek/mt8183/mt8183-afe-pcm.c b/sound/soc/mediatek/mt8183/mt8183-afe-pcm.c
index 263469953..99f843499 100644
--- a/sound/soc/mediatek/mt8183/mt8183-afe-pcm.c
+++ b/sound/soc/mediatek/mt8183/mt8183-afe-pcm.c
@@ -708,6 +708,16 @@ static int mt8183_afe_runtime_resume(struct device *dev)
 	struct mt8183_afe_private *afe_priv = afe->platform_priv;
 	int ret;
 
+	/*
+	 * The audiosys clock gates (AUDIO_TOP_CON0/1) are written through this same
+	 * syscon regmap. It has no cache, so while it is cache-only every gate write is
+	 * dropped: leave cache-only mode before the clocks are enabled, or the AFE and
+	 * I2S clocks stay gated whenever the bootloader left them off (Echo Show 8 2nd
+	 * gen: memif never runs, no IRQs).
+	 */
+	if (afe->regmap && !afe_priv->pm_runtime_bypass_reg_ctl)
+		regcache_cache_only(afe->regmap, false);
+
 	ret = mt8183_afe_enable_clock(afe);
 	if (ret)
 		return ret;
@@ -715,7 +725,6 @@ static int mt8183_afe_runtime_resume(struct device *dev)
 	if (!afe->regmap || afe_priv->pm_runtime_bypass_reg_ctl)
 		goto skip_regmap;
 
-	regcache_cache_only(afe->regmap, false);
 	regcache_sync(afe->regmap);
 
 	/* enable audio sys DCM for power saving */
