+	 * line is level-triggered, so a plug already in the jack at power-on fires it at once, and
+	 * the handler then needs the work queue to flip the polarity and report the plug-in.
+	 */
+	accdet_eint_wq = create_singlethread_workqueue("accdet_eint");
