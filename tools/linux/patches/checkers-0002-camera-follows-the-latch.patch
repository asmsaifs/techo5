diff --git a/drivers/misc/gating.c b/drivers/misc/gating.c
index 2920673bca8a..0c8deec0ac98 100644
--- a/drivers/misc/gating.c
+++ b/drivers/misc/gating.c
@@ -484,6 +484,11 @@ static int gating_probe(struct platform_device *pdev)
 	}
 
 	priv->input_event->priv = priv;
+	/*
+	 * The latch is hardware and survives a reboot. Starting from what the state pin says, not from
+	 * zero, keeps a long press after a boot with the latch engaged from being taken the wrong way.
+	 */
+	priv->cur_state = __gating_state(priv);
 	priv->req_state = NONE;
 	INIT_WORK(&priv->priv_update, gating_update_work_func);
 
diff --git a/drivers/misc/mediatek/imgsensor/src/mt8163/camera_hw/camera_project/checkers/kd_camera_hw.c b/drivers/misc/mediatek/imgsensor/src/mt8163/camera_hw/camera_project/checkers/kd_camera_hw.c
index cecaaf70aeca..8b520787a3c0 100644
--- a/drivers/misc/mediatek/imgsensor/src/mt8163/camera_hw/camera_project/checkers/kd_camera_hw.c
+++ b/drivers/misc/mediatek/imgsensor/src/mt8163/camera_hw/camera_project/checkers/kd_camera_hw.c
@@ -81,11 +81,25 @@ static enum gating_state conf_cam_gate(enum gating_state state)
 /* set_gate_state() : check and configure the camera gating state */
 static enum gating_state set_gate_state(enum gating_state state)
 {
+	int latch;
+
 	if (!cam_gate)
 		return state;
 
+	latch = gating_hw_state();
+
 	mutex_lock(&cam_gate->mutex);
 
+	/*
+	 * Go by the latch as the state pin reports it, not as the last notification left it. A quick
+	 * tap that releases the latch sends no notification (gating.c only acts on a long press), and
+	 * a latch engaged before boot was never announced at all. Trusting req_state left the camera
+	 * refused after the first, and powered into a rail the latch holds down after the second -
+	 * both for the rest of the boot.
+	 */
+	if (latch == UNGATED || latch == GATED)
+		cam_gate->req_state = latch;
+
 	/* Make sure device is in UNGATED Mode before trying to enable CAM */
 	if (state == UNGATED && cam_gate->req_state != UNGATED) {
 		pr_info("Failed to enable CAM, GATING Mode is ON\n");
