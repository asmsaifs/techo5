+/// Follows the named pipe at `path` for volumes, one per line, and sends each on. The pipe is opened
+/// for writing as well, so opening it never waits for a writer and it never ends between writers; should
+/// it end or fail anyway, it is opened again. A line that is not a volume is dropped, and so is one far
+/// too long to be one, without losing the line after it.
+fn follow_volume_fifo(path: PathBuf, tx: tokio::sync::mpsc::UnboundedSender<u16>) {
+    use std::io::{BufRead, BufReader, Read};
+    const LONGEST: u64 = 16;
+    loop {
+        match std::fs::OpenOptions::new().read(true).write(true).open(&path) {
+            Ok(file) => {
+                let mut reader = BufReader::new(file);
+                let mut line = Vec::new();
+                let mut too_long = false;
+                loop {
+                    line.clear();
+                    match (&mut reader).take(LONGEST).read_until(b'\n', &mut line) {
+                        Ok(0) => break,
+                        Ok(_) => {}
+                        Err(e) => {
+                            warn!("Reading --volume-fifo failed: {e}");
+                            break;
+                        }
+                    }
+                    if line.last() != Some(&b'\n') {
+                        // Part of a line too long to be a volume: the rest of it is dropped too.
+                        too_long = true;
+                        continue;
+                    }
+                    if std::mem::take(&mut too_long) {
+                        continue;
+                    }
+                    match std::str::from_utf8(&line).ok().and_then(|l| l.trim().parse::<u16>().ok()) {
+                        Some(volume) => {
+                            if tx.send(volume).is_err() {
+                                return;
+                            }
+                        }
+                        None => warn!("Ignoring a line from --volume-fifo that is not a volume"),
+                    }
+                }
+            }
+            Err(e) => warn!("Opening --volume-fifo failed: {e}"),
+        }
+        std::thread::sleep(Duration::from_secs(1));
     }
 }
 
