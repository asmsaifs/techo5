+/// HostMixer keeps the volume without applying it, for a host that plays the volume itself
+/// (`--volume-fifo`): the audio is passed on unscaled.
+struct HostMixer(AtomicU16);
+
+impl mixer::Mixer for HostMixer {
+    fn open(_: MixerConfig) -> Result<Self, librespot::core::Error> {
+        Ok(Self(AtomicU16::new(VolumeCtrl::MAX_VOLUME)))
+    }
+
+    fn volume(&self) -> u16 {
+        self.0.load(Ordering::Relaxed)
+    }
+
+    fn set_volume(&self, volume: u16) {
+        self.0.store(volume, Ordering::Relaxed)
+    }
+}
+
+fn host_mixer(config: MixerConfig) -> Result<Arc<dyn mixer::Mixer>, librespot::core::Error> {
+    Ok(Arc::new(<HostMixer as mixer::Mixer>::open(config)?))
+}
